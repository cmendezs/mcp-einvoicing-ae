<?xml version="1.0"?>
<gc:Codelist xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
  <gc:Identification>
    <gc:ShortName Lang="en">Tax Data Document type code</gc:ShortName>
    <gc:Version>TDT-type-1</gc:Version>
  </gc:Identification>
  <gc:ColumnSet>
    <gc:Column Id="id" Use="required">
      <gc:ShortName>Identifier</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="name" Use="optional">
      <gc:ShortName>Name</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="description" Use="optional">
      <gc:ShortName>Description</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Key Id="idKey">
      <gc:ColumnRef Ref="id"/>
    </gc:Key>
  </gc:ColumnSet>
  <gc:SimpleCodeList>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>S</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Submit</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="description">
        <gc:SimpleValue>Submitting a Tax Data Document</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>R</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Resubmit</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="description">
        <gc:SimpleValue>TDD is sent to revise a previously reported TDD.</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>W</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Withdraw</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="description">
        <gc:SimpleValue>I previously reported TDD is withdrawn.</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>F</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Failed</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="description">
        <gc:SimpleValue>Document failed validation.</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
  </gc:SimpleCodeList>
</gc:Codelist>
