<?xml version="1.0"?>
<gc:Codelist xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
  <gc:Identification>
    <gc:ShortName Lang="en">Tax Data Document scope</gc:ShortName>
    <gc:Version>TDT-scope-1</gc:Version>
  </gc:Identification>
  <gc:ColumnSet>
    <gc:Column Id="id" Use="required">
      <gc:ShortName>Identifier</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="name" Use="optional">
      <gc:ShortName>Name</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="description" Use="optional">
      <gc:ShortName>Description</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Key Id="idKey">
      <gc:ColumnRef Ref="id"/>
    </gc:Key>
  </gc:ColumnSet>
  <gc:SimpleCodeList>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>D</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Domestic</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="description">
        <gc:SimpleValue>Reporting on a domestic invoice.</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>IP</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>International Peppol invoice</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="description">
        <gc:SimpleValue>Reporting on an international invoice exchanged through the Peppol network.</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>INP</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>International non-Peppol</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="description">
        <gc:SimpleValue>A discount given by the manufacturer which should be passed on to the consumer.</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
  </gc:SimpleCodeList>
</gc:Codelist>
